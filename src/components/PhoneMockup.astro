---
// PhoneMockup.astro — Celular con conversación WhatsApp + efecto 3D
---

<div class="scene" id="phone-scene">
  <div class="phone-wrapper" id="phone-3d">

    <div class="phone-scale">
      
      <!-- Elementos flotantes de venta perdida -->
      <div class="float-badge fb-1">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        - $120.00
      </div>
      <div class="float-badge fb-2">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
        Venta Perdida
      </div>
      <div class="float-badge fb-3">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="18" y1="8" x2="23" y2="13"></line><line x1="23" y1="8" x2="18" y2="13"></line></svg>
        Cliente ignorado
      </div>

      <!-- Marco del celular sin notch -->
      <div class="phone-frame">

      <!-- Pantalla: WhatsApp Dark Mode -->
      <div class="phone-screen">

        <!-- Header WhatsApp -->
        <div class="wa-header">
          <div class="wa-back">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          </div>
          <div class="wa-avatar">C</div>
          <div class="wa-contact-info">
            <span class="wa-contact-name">Cliente</span>
            <span class="wa-status">en línea</span>
          </div>
          <div class="wa-header-icons">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
          </div>
        </div>

        <!-- Área de chat -->
        <div class="wa-chat">

          <!-- Divider fecha -->
          <div class="wa-divider">Hoy — 10:23 AM</div>

          <!-- Mensajes recibidos -->
          <div class="wa-msg wa-received">
            <p>Hola, ¿tienen la chaqueta en talla M disponible? 🙏</p>
            <span class="wa-time">10:23</span>
          </div>

          <div class="wa-msg wa-received">
            <p>¿Y cuánto cuesta?</p>
            <span class="wa-time">10:25</span>
          </div>

          <!-- Divider tiempo -->
          <div class="wa-divider">5 horas después...</div>

          <div class="wa-msg wa-received">
            <p>¿Hay alguien? Llevo horas esperando respuesta 🥲</p>
            <span class="wa-time">15:47</span>
          </div>

          <div class="wa-msg wa-received">
            <p>Ya le compré a otra tienda. Qué mala atención 😒</p>
            <span class="wa-time">16:02</span>
          </div>

          <!-- Mensaje enviado -->
          <div class="wa-msg wa-sent">
            <p>¡Hola! Sí tenemos talla M, ¿en qué le puedo ayudar? 😊</p>
            <span class="wa-time">16:18 <span class="wa-ticks"><svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin-left:-8px"><polyline points="20 6 9 17 4 12"></polyline></svg></span></span>
          </div>



        </div>

        <!-- Input bar -->
        <div class="wa-input-bar">
          <div class="wa-input-field">Escribe un mensaje...</div>
          <div class="wa-send-btn">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="transform: translateX(-1px) translateY(1px)"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </div>
        </div>

      </div>
      <!-- fin phone-screen -->

    </div>
    <!-- fin phone-frame -->
    </div>
    <!-- fin phone-scale -->

    <!-- Sombra 3D flotante -->
    <div class="phone-shadow"></div>

  </div>
</div>

<style>
  /* ── Escena 3D ── */
  .scene {
    perspective: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    /* Evita la selección de texto para que parezca una imagen real */
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  .phone-wrapper {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.12s ease-out;
    cursor: pointer;
    animation: float 6s ease-in-out infinite;
  }

  .phone-scale {
    transform: scale(1.18);
    transform-style: preserve-3d;
  }

  @keyframes float {
    0%   { transform: translateY(0px) rotateX(3deg) rotateY(-10deg); }
    50%  { transform: translateY(-12px) rotateX(-3deg) rotateY(10deg); }
    100% { transform: translateY(0px) rotateX(3deg) rotateY(-10deg); }
  }

  /* ── Marco del celular ── */
  .phone-frame {
    width: 240px;
    height: 480px;
    background: linear-gradient(145deg, #2a2a2a, #111);
    border-radius: 36px;
    padding: 8px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.08),
      0 30px 80px rgba(0,0,0,0.6),
      0 10px 30px rgba(123,63,228,0.2);
    position: relative;
    transform-style: preserve-3d;
  }

  /* Bordes redondeados internos sin notch */
  .phone-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 36px;
    background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 50%);
    pointer-events: none;
  }

  /* ── Pantalla ── */
  .phone-screen {
    background: #0B141A; /* Modo oscuro WhatsApp */
    border-radius: 28px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* ── Header WhatsApp ── */
  .wa-header {
    background: #202C33; /* Header oscuro */
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .wa-back {
    color: #AEBAC1;
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .wa-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fe6a5c; /* Color personalizado avatar */
    color: #111; /* Texto oscuro para contrastar con coral */
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    flex-shrink: 0;
  }

  .wa-contact-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .wa-contact-name {
    color: #E9EDEF;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .wa-status {
    color: #8696A0;
    font-family: var(--font-body);
    font-size: 0.6rem;
    line-height: 1;
  }

  .wa-header-icons {
    display: flex;
    gap: 12px;
    color: #AEBAC1;
    align-items: center;
  }

  /* ── Chat ── */
  .wa-chat {
    flex: 1;
    overflow: hidden;
    padding: 10px 10px 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* Fondo oscuro con un pattern sutil */
    background-color: #0B141A;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 30' fill='none' stroke='%23ffffff' stroke-width='0.3' opacity='0.03'/%3E%3C/svg%3E");
  }

  /* ── Dividers ── */
  .wa-divider {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.55rem;
    color: #8696A0;
    background: #182229;
    border-radius: 8px;
    padding: 4px 10px;
    align-self: center;
    margin: 4px 0;
  }

  /* ── Mensajes ── */
  .wa-msg {
    max-width: 85%;
    border-radius: 8px;
    padding: 6px 8px 4px;
    position: relative;
    transform: translateZ(8px); /* profundidad 3D */
    box-shadow: 0 1px 1px rgba(0,0,0,0.2);
  }

  .wa-msg p {
    font-family: var(--font-body);
    font-size: 0.65rem;
    line-height: 1.4;
    margin: 0;
    color: #E9EDEF;
  }

  .wa-time {
    font-family: var(--font-body);
    font-size: 0.5rem;
    color: #8696A0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 2px;
  }

  .wa-ticks {
    color: #53BDEB; /* Azul claro para los ticks */
    display: flex;
  }

  /* Recibidos */
  .wa-received {
    background: #202C33;
    align-self: flex-start;
    border-radius: 0 8px 8px 8px;
  }

  /* Enviados */
  .wa-sent {
    background: #fe6a5c; /* Color personalizado burbuja enviada */
    align-self: flex-end;
    border-radius: 8px 0 8px 8px;
  }

  .wa-sent .wa-time {
    color: rgba(0,0,0,0.6); /* Color de tiempo más oscuro para contraste */
  }



  /* ── Input bar ── */
  .wa-input-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: #202C33;
    flex-shrink: 0;
  }

  .wa-input-field {
    flex: 1;
    background: #2A3942;
    border-radius: 20px;
    padding: 8px 12px;
    font-family: var(--font-body);
    font-size: 0.6rem;
    color: #8696A0;
  }

  .wa-send-btn {
    width: 34px;
    height: 34px;
    background: #fe6a5c; /* Color personalizado botón enviar */
    color: #111;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Sombra flotante ── */
  .phone-shadow {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%) translateZ(-60px);
    width: 180px;
    height: 40px;
    background: rgba(45, 10, 110, 0.5);
    filter: blur(20px);
    border-radius: 50%;
    transition: all 0.12s ease-out;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .phone-frame {
      width: 200px;
      height: 400px;
    }
  }

  @media (max-width: 768px) {
    .phone-scale {
      transform: scale(0.9);
    }
    
    .phone-frame {
      width: 240px;
      height: 480px;
    }
  }

  /* ── Elementos Flotantes ── */
  .float-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(28, 6, 71, 0.9); /* Un poco más opaco para evitar transparencias raras */
    border: 1px solid rgba(255, 107, 91, 0.5);
    color: var(--coral);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 10px 16px;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    pointer-events: none;
    transform-style: preserve-3d;
    z-index: 100; /* Forzamos que siempre esté al frente */
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity; /* Ayuda al GPU del celular */
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Posiciones alejadas del chat y animaciones secuenciales */
  .fb-1 { top: 15%; left: -30px; animation: popup 9s ease-in-out infinite 0s; }
  .fb-2 { bottom: 25%; right: -20px; animation: popup 9s ease-in-out infinite 3s; border-color: rgba(255,240,160,0.4); color: var(--yellow-pastel); }
  .fb-3 { top: 60%; left: -20px; animation: popup 9s ease-in-out infinite 6s; }

  @keyframes popup {
    0%   { opacity: 0; transform: translate3d(0, 15px, 50px); }
    10%  { opacity: 1; transform: translate3d(0, 0px, 50px); }
    25%  { opacity: 1; transform: translate3d(0, -5px, 50px); }
    33%  { opacity: 0; transform: translate3d(0, -15px, 50px); }
    100% { opacity: 0; transform: translate3d(0, -15px, 50px); }
  }
</style>

<script>
  const scene = document.getElementById('phone-scene');
  const phone = document.getElementById('phone-3d');

  if (scene && phone) {
    const MAX_TILT = 18;

    scene.addEventListener('mousemove', (e) => {
      // Evitar animar mientras estamos flotando en hover, el requestAnimationFrame
      // podría usarse pero esta interpolación CSS es más sencilla
      const rect = scene.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      // Normalizar entre -1 y 1
      const normX = (e.clientX - centerX) / (rect.width / 2);
      const normY = (e.clientY - centerY) / (rect.height / 2);

      const rotateY =  normX * MAX_TILT;
      const rotateX = -normY * MAX_TILT;

      // Mantener translateY(0) para no sobreescribir la animación de float por completo
      phone.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      phone.style.animation = 'none'; // Pausar el float mientras interactúa
    });

    scene.addEventListener('mouseleave', () => {
      phone.style.transform = 'rotateX(0deg) rotateY(0deg)';
      phone.style.animation = 'float 6s ease-in-out infinite'; // Reanudar float
    });
  }
</script>

---
// AuthorBio.astro — Sección de biografía de la autora
---

<section class="author-section">
  <div class="author-container">
    
    <!-- Avatar femenino -->
    <div class="author-avatar-wrapper">
      <div class="author-avatar">
        <!-- Semilla "Bella" con escala para llenar el círculo y tocar el borde inferior -->
        <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Bella&backgroundColor=transparent&scale=130&translateY=15" alt="Naty Restrepo" />
      </div>
    </div>

    <!-- Contenido -->
    <div class="author-content">
      <div class="author-header">
        <h2 class="author-name">Naty Restrepo</h2>
      </div>
      <p class="author-title">Estratega de Ventas Digitales <span class="dot">•</span> Especialista en E-commerce</p>
      
      <p class="author-bio">
        Llevo años ayudando a dueños de tiendas online a convertir su WhatsApp de un canal de caos en un <strong>sistema de ventas</strong> que funciona incluso cuando no están mirando el teléfono. 
      </p>

    </div>

  </div>
</section>

<style>
  /* 
    Sección de ancho completo con 'violet-soft'. 
    Es luminoso para romper el diseño oscuro, pero pertenece 100% 
    a la paleta morada de la marca, creando una armonía perfecta. 
  */
  .author-section {
    /* Degradado entre violet-soft y un tono lila más oscuro hacia abajo */
    background: linear-gradient(to bottom, var(--violet-soft) 0%, #D1BCFF 100%);
    padding: 6rem 1.5rem;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    border-top: 1px solid rgba(123, 63, 228, 0.1); /* Borde morado sutil */
    border-bottom: 1px solid rgba(123, 63, 228, 0.1);
  }

  .author-container {
    max-width: 950px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4.5rem;
  }

  /* Avatar elegante */
  .author-avatar-wrapper {
    flex-shrink: 0;
  }

  .author-avatar {
    width: 210px;
    height: 210px;
    background: var(--yellow-pastel); /* El amarillo resalta precioso sobre el lila claro */
    border: 3px solid var(--violet-deep);
    border-radius: 50%;
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: 0; /* Sin padding para que el avatar toque los bordes */
    box-shadow: 0 15px 35px rgba(28, 6, 71, 0.15); /* Sombra morada oscura */
    transition: transform 0.3s ease;
  }

  .author-avatar:hover {
    transform: translateY(-5px);
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Contenido y tipografía */
  .author-content {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .author-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 0.3rem;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 800;
    color: var(--violet-deep); /* Máximo contraste y coherencia de marca */
    letter-spacing: -0.04em;
    line-height: 1;
  }


  .author-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    color: var(--violet-mid); /* Morado medio para el cargo */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.8rem;
  }

  .dot {
    margin: 0 4px;
    color: var(--coral);
  }

  .author-bio {
    font-family: var(--font-body);
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--violet-deep);
    font-weight: 500;
    margin-bottom: 1.5rem;
    opacity: 0.85;
  }

  .author-bio strong {
    color: var(--violet-deep);
    font-weight: 800;
    background: rgba(255, 107, 91, 0.15); /* Subrayado coral sutil */
    padding: 0 4px;
    border-radius: 4px;
  }



  /* Responsive */
  @media (max-width: 900px) {
    .author-container {
      flex-direction: column;
      text-align: center;
      gap: 2.5rem;
    }
    
    .author-header {
      justify-content: center;
      flex-wrap: wrap;
    }

    .author-title {
      font-size: 0.85rem;
    }
    

  }

  @media (max-width: 480px) {
    .author-name {
      font-size: 2.5rem;
    }

    .author-avatar {
      width: 140px;
      height: 140px;
    }
  }
</style>

---
// Footer.astro — Cierre de página detallado
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    
    <div class="footer-grid">
      <!-- Columna 1: Branding -->
      <div class="footer-col branding">
        <span class="logo-text">Naty Restrepo</span>
        <p class="tagline">Ayudo a dueños de e-commerce a escalar sus ventas mediante sistemas probados de WhatsApp y CRO.</p>
        <div class="social-links">
          <a href="#" aria-label="Instagram" class="social-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="social-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="#" aria-label="YouTube" class="social-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="footer-col">
        <h4 class="col-title">Explorar</h4>
        <ul class="footer-links">
          <li><a href="#">Inicio</a></li>
          <li><a href="#">Diagnóstico</a></li>
          <li><a href="#">Sobre mí</a></li>
          <li><a href="#">Guía Gratis</a></li>
        </ul>
      </div>

      <!-- Columna 3: Servicios -->
      <div class="footer-col">
        <h4 class="col-title">Servicios</h4>
        <ul class="footer-links">
          <li><a href="#">Auditoría SEO</a></li>
          <li><a href="#">Estrategia CRO</a></li>
          <li><a href="#">WhatsApp Sales</a></li>
          <li><a href="#">Mentoría 1:1</a></li>
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div class="footer-col">
        <h4 class="col-title">Contacto</h4>
        <p class="contact-info">¿Tienes dudas?</p>
        <a href="mailto:hola@natyrestrepo.com" class="email-link">hola@natyrestrepo.com</a>
        <p class="contact-sub">Medellín, Colombia</p>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="copyright">© {currentYear} Naty Restrepo. Todos los derechos reservados.</p>
      <div class="legal-links">
        <a href="#">Privacidad</a>
        <a href="#">Términos</a>
        <a href="#">Cookies</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--violet-dark);
    padding: 6rem 1.5rem 3rem 1.5rem;
    border-top: 1px solid rgba(169, 110, 255, 0.1);
    width: 100%;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 4rem;
    margin-bottom: 4rem;
    text-align: left; /* Alineación a la izquierda por defecto */
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-light);
    display: block;
    margin-bottom: 1.2rem;
    letter-spacing: -0.02em;
    text-align: left;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--violet-bright);
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.8;
    text-align: left;
    max-width: 300px; /* Evita que el texto se estire demasiado */
  }

  .col-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-light);
    margin-bottom: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: left;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .footer-links li {
    margin-bottom: 1rem;
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--violet-bright);
    text-decoration: none;
    transition: all 0.2s ease;
    opacity: 0.7;
  }

  .footer-links a:hover {
    color: var(--yellow-pastel);
    opacity: 1;
    padding-left: 5px;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-icon {
    width: 36px;
    height: 36px;
    background: rgba(169, 110, 255, 0.1);
    border: 1px solid rgba(169, 110, 255, 0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-light);
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: var(--violet-mid);
    border-color: var(--violet-bright);
    transform: translateY(-3px);
  }

  .email-link {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--yellow-pastel);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
  }

  .contact-info {
    font-family: var(--font-body);
    color: var(--text-light);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .contact-sub {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--violet-bright);
    opacity: 0.6;
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(169, 110, 255, 0.2), transparent);
    margin-bottom: 2.5rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--violet-bright);
    opacity: 0.6;
  }

  .legal-links {
    display: flex;
    gap: 2rem;
  }

  .legal-links a {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--violet-bright);
    opacity: 0.6;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .legal-links a:hover {
    opacity: 1;
    color: var(--text-light);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: left; /* Alineación a la izquierda también en móvil */
    }
    
    .social-links {
      justify-content: flex-start; /* Iconos a la izquierda */
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1.5rem;
      text-align: left;
      align-items: flex-start;
    }
    
    .legal-links {
      justify-content: flex-start;
      gap: 1.2rem;
    }
  }
</style>

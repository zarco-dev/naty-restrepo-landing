---
// Hero.astro — Sección principal
import PhoneMockup from './PhoneMockup.astro';
---

<section class="hero">

  <!-- ── Columna izquierda: texto ── -->
  <div class="hero-text">


    <!-- Eyebrow Tag -->
    <span class="hero-eyebrow">
      GUÍA GRATUITA – E-COMMERCE
    </span>

    <!-- Título principal -->
    <h1 class="hero-title">
      10 Señales de que<br>
      tu <span class="accent-yellow">WhatsApp</span> te<br>
      está <span class="accent-coral">costando</span><br>
      ventas hoy
    </h1>

    <!-- Bullets -->
    <ul class="hero-bullets">
      <li>Para dueños de tiendas online que venden por WhatsApp</li>
      <li>Con acción concreta para cada señal detectada</li>
      <li>Aplicable desde el mismo día que lo descargas</li>
    </ul>

    <!-- CTA -->
    <div class="hero-cta-group">
      <a href="#" class="btn-hero">Descargar guía gratis →</a>
      <p class="hero-trust">Sin spam · Sin costo · Descarga inmediata</p>
    </div>

  </div>

  <!-- ── Columna derecha: mockup 3D ── -->
  <div class="hero-visual">
    <PhoneMockup />
  </div>

</section>

<style>
  /* ── Elimina padding del main cuando hay hero ── */
  :global(main:has(.hero)) {
    padding: 0;
  }

  /* ── Layout general ── */
  :root { --nav-height: 64px; }

  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr; /* Da más espacio al texto (izquierda) y empuja el celular a la derecha */
    gap: 3rem;
    align-items: center;
    min-height: 100vh;
    padding: 7rem 1.5rem 2rem 1.5rem; /* Margen superior para despegarlo de la navbar fija */
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Brand tag ── */
  .hero-brand-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  .brand-line {
    display: inline-block;
    width: 28px;
    height: 2px;
    background: var(--coral);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--coral);
  }

  /* ── Eyebrow Tag ── */
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    color: var(--coral);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    background: rgba(255, 107, 91, 0.1);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
  }

  /* ── Título ── */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 3.5rem); /* Título aumentado según solicitud */
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-light);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .accent-yellow {
    color: var(--yellow-pastel);
    font-style: italic;
  }

  .accent-coral {
    color: var(--coral);
    font-style: italic;
  }

  /* ── Subtítulo ── */
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--violet-bright);
    line-height: 1.6;
    margin-bottom: 0.9rem;
    max-width: 480px;
  }

  /* ── Bullets ── */
  .hero-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .hero-bullets li {
    font-family: var(--font-body);
    font-size: 1.1rem; /* Reducido ligeramente a petición */
    color: var(--text-light);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }

  .hero-bullets li::before {
    content: "●";
    color: var(--coral);
    font-size: 0.7rem;
    flex-shrink: 0;
    margin-top: 5px;
  }

  /* ── CTA ── */
  .hero-cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .btn-hero {
    display: inline-block;
    background: var(--yellow-pastel);
    color: var(--violet-deep);
    font-family: var(--font-body);
    font-size: 1.15rem; /* Botón más grande */
    font-weight: 800;
    padding: 1rem 2.2rem; /* Más área de clic (padding) */
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(255, 240, 160, 0.3);
    color: var(--violet-deep);
  }

  .hero-trust {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--violet-mid);
    margin: 0;
  }

  /* ── Visual derecha (contiene el PhoneMockup) ── */
  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 6rem 1.5rem 3rem 1.5rem;
      height: auto;
      min-height: 100dvh;
    }

    .hero-visual {
      /* Texto primero, visual segundo */
      order: 1;
    }

    .hero-placeholder {
      aspect-ratio: 4/3;
      max-height: 240px;
      border-radius: 16px;
    }

    .hero-subtitle {
      max-width: 100%;
    }

    .btn-hero {
      width: 100%;
      text-align: center;
    }

    .hero-cta-group {
      align-items: center;
    }

    .hero-trust {
      text-align: center;
    }
  }
</style>
